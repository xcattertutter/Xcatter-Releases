{
  "name": "xcatter-companion",
  "version": "0.7.26",
  "description": "Portable, external farming session tracker for Torchlight: Infinite.",
  "author": "Xcatter",
  "private": true,
  "main": "desktop-dist/electron.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop:web": "vite build --config vite.desktop.config.ts",
    "desktop:prepare": "npm run desktop:web && node -e \"const f=require('fs');for(const n of ['electron.mjs','preload.cjs','overlay.html','items-afterlight.json','zones-afterlight.json','update-config.json'])f.copyFileSync('desktop/'+n,'desktop-dist/'+n)\"",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable --x64",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.xcatter.companion",
    "productName": "Xcatter",
    "artifactName": "Xcatter-Portable-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop-dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/xcatter-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
